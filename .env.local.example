# Member portal — Supabase, service_role key, server-side only (never
# exposed to the browser bundle — only used inside app/api/** route
# handlers and server components). Get from Supabase Dashboard →
# Project Settings → API → service_role (secret). Same project as the
# WhatsApp bot and internal dashboard.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# The WhatsApp bot's URL — the portal's OTP login calls the bot's
# POST /internal/send-otp to actually deliver the code, so WhatsApp
# credentials stay in one place (the bot) instead of being duplicated
# here.
BOT_URL=https://flex-fitness-whatsapp-bot.onrender.com

# Shared secret for that call. Must match MEMBER_AUTH_SECRET in the
# bot's own .env / Render environment variables.
MEMBER_AUTH_SECRET=
